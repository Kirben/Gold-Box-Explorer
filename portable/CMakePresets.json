{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "release-common",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-release",
      "inherits": "release-common",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-release",
      "inherits": "release-common",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "macos-release",
      "inherits": "release-common",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "windows-mingw-release",
      "inherits": "release-common",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++",
        "CMAKE_PREFIX_PATH": "$env{WX_WINDOWS_PREFIX}",
        "CMAKE_EXE_LINKER_FLAGS": "-static -static-libgcc -static-libstdc++",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-release", "configurePreset": "linux-release", "configuration": "Release" },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release" },
    { "name": "macos-release", "configurePreset": "macos-release", "configuration": "Release" },
    { "name": "windows-mingw-release", "configurePreset": "windows-mingw-release", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "linux-release", "configurePreset": "linux-release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "macos-release", "configurePreset": "macos-release", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
